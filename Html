<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1024, user-scalable=no">
  <title>NebulaCompany</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #000;
      color: #fff;
      line-height: 1.6;
    }

    header {
      background: #000;
      color: #fff;
      padding: 20px;
    }

    header .header-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    header img {
      max-width: 200px;
      height: auto;
    }

    nav ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
    }

    nav ul li {
      margin: 0 10px;
    }

    nav ul li a {
      color: #fff;
      text-decoration: none;
      font-size: 16px;
    }

    nav ul li a:hover {
      color: #4CAF50;
    }

    .main-container {
      display: flex;
      flex-wrap: wrap;
      margin: 20px;
    }

    .content {
      flex: 3;
      min-width: 300px;
    }

    .post {
      background-color: #1a1a1a;
      margin-bottom: 30px;
      padding: 20px;
      border-radius: 8px;
    }

    .post img {
      width: 100%;
      border-radius: 8px;
      margin-bottom: 15px;
    }

    .post h2 {
      font-size: 24px;
      margin-bottom: 10px;
      color: #fff;
    }

    .post .category {
      font-size: 14px;
      color: #bbb;
    }

    .post .date {
      font-size: 12px;
      color: #777;
      margin-top: 10px;
    }

    .sidebar {
      flex: 1;
      min-width: 250px;
      padding: 20px;
      background-color: #1a1a1a;
      margin-left: 20px;
      border-radius: 8px;
    }

    .sidebar h3 {
      font-size: 22px;
      margin-bottom: 10px;
    }

    .sidebar input {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border-radius: 4px;
      border: 1px solid #444;
      background-color: #222;
      color: #fff;
      font-size: 16px;
    }

    footer {
      background: #000;
      color: #fff;
      text-align: center;
      padding: 15px;
      margin-top: 20px;
    }

    @media screen and (orientation: portrait) {
      body::before {
        content: "Por favor gira tu dispositivo a horizontal para ver el contenido correctamente.";
        position: fixed;
        z-index: 9999;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #000;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        text-align: center;
        padding: 20px;
      }

      .main-container, footer {
        display: none;
      }
    }
  </style>
</head>
<body>

